---
import { type CollectionEntry, getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';

interface Props {
	entry: CollectionEntry<'work'>;
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
	const work = await getCollection('work');
	return work.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const year = entry.data.publishDate.getFullYear();
---

<BaseLayout
	title={`${entry.data.title} | Jérémy Cartallier`}
	description={entry.data.description}
	image={entry.data.img}
>
	<div class="stack gap-20">
		<article class="project">
			<div class="project-inner stack gap-8">
				<a class="back-link" href="/work/">
					<Icon icon="arrow-left" size="1.1em" /> Retour aux projets
				</a>

				<header class="project-header stack gap-5">
					<h1 class="title">{entry.data.title}</h1>
					<p class="lead">{entry.data.description}</p>
				</header>

				{
					entry.data.img && (
						<figure class="cover">
							<img src={entry.data.img} alt={entry.data.img_alt || ''} />
						</figure>
					)
				}

				<div class="project-body">
					<aside class="meta">
						<div class="meta-block">
							<span class="meta-label">Année</span>
							<span class="meta-value">{year}</span>
						</div>
						<div class="meta-block">
							<span class="meta-label">Stack technique</span>
							<ul class="tags">
								{entry.data.tags.map((t) => (
									<li>
										<Pill>{t}</Pill>
									</li>
								))}
							</ul>
						</div>
					</aside>

					<div class="content">
						<Content />
					</div>
				</div>

				<a class="back-link" href="/work/">
					<Icon icon="arrow-left" size="1.1em" /> Tous les projets
				</a>
			</div>
		</article>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.project {
		padding-top: 1rem;
	}

	.project-inner {
		width: 100%;
		max-width: 68rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	/* Back link */
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--gray-300);
		font-weight: 500;
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.back-link:hover,
	.back-link:focus {
		color: var(--accent-regular);
	}

	/* Header */
	.title {
		font-size: var(--text-4xl);
		color: var(--gray-0);
		max-width: 20ch;
	}

	.lead {
		font-size: var(--text-lg);
		color: var(--gray-300);
		max-width: 60ch;
	}

	/* Cover image */
	.cover {
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid var(--gray-800);
		border-radius: 1.25rem;
		box-shadow: var(--shadow-md);
		background: var(--gradient-subtle);
	}

	.cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Body layout */
	.project-body {
		display: grid;
		gap: 2.5rem;
	}

	/* Meta sidebar */
	.meta {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.meta-block {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.meta-label {
		font-size: var(--text-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray-400);
	}

	.meta-value {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	/* Prose content */
	.content {
		color: var(--gray-200);
		font-size: var(--text-md);
		line-height: 1.7;
	}

	.content > :global(* + *) {
		margin-top: 1rem;
	}

	.content :global(h2) {
		margin: 2.5rem 0 0.75rem;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content :global(h2:first-child) {
		margin-top: 0;
	}

	.content :global(h3) {
		margin: 2rem 0 0.5rem;
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	.content :global(ul),
	.content :global(ol) {
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.content :global(li::marker) {
		color: var(--accent-regular);
	}

	.content :global(strong) {
		color: var(--gray-0);
		font-weight: 600;
	}

	.content :global(img) {
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
	}

	.content :global(blockquote) {
		margin: 1.5rem 0;
		padding: 1rem 1.5rem;
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: var(--text-lg);
		line-height: 1.4;
		color: var(--gray-0);
		border-inline-start: 3px solid var(--accent-regular);
		background: var(--gray-999_40);
		border-radius: 0 0.75rem 0.75rem 0;
	}

	.content :global(a) {
		color: var(--accent-regular);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	@media (min-width: 50em) {
		.title {
			max-width: 24ch;
		}

		.cover {
			border-radius: 1.75rem;
		}

		.project-body {
			grid-template-columns: 15rem 1fr;
			gap: 4rem;
			align-items: start;
		}

		.meta {
			position: sticky;
			top: 2rem;
			padding-bottom: 0;
			border-bottom: none;
		}
	}
</style>
