---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Projets"
	description="Une sélection de projets menés par Jérémy Cartallier en environnement produit, e-commerce et freelance."
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Projets"
				tagline="Des projets réalisés en entreprise et en mission, avec un focus sur la qualité d'implémentation, la clarté des interfaces et la maintenabilité." 
				align="start"
			/>
			<Grid variant="offset">
				{
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				}
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>
