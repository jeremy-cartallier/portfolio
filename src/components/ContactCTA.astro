---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside class="contact">
	<div class="panel">
		<div class="text stack gap-2">
			<p class="eyebrow">Contact</p>
			<h2>Vous recrutez ou lancez un projet front-end ?</h2>
			<p class="sub">Disponible pour un poste en CDI ou une mission freelance — parlons-en.</p>
		</div>
		<div class="actions">
			<CallToAction href="mailto:pro@jeremy-cartallier.fr">
				Me contacter
				<Icon icon="paper-plane-tilt" size="1.2em" />
			</CallToAction>
			<div class="socials">
				<a
					href="https://www.linkedin.com/in/jeremy-cartallier/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="LinkedIn"
				>
					<Icon icon="linkedin-logo" size="1.4em" />
				</a>
				<a
					href="https://github.com/jeremy-cartallier"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="GitHub"
				>
					<Icon icon="github-logo" size="1.4em" />
				</a>
				<a
					href="https://www.malt.fr/profile/jeremycartallier"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Malt"
				>
					<Icon icon="malt-logo" size="1.4em" />
				</a>
			</div>
		</div>
	</div>
</aside>

<style>
	.contact {
		width: 100%;
		max-width: 83rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	.panel {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
		padding: 2.5rem 1.75rem;
		border: 1px solid color-mix(in srgb, var(--accent-regular) 25%, var(--gray-800));
		border-radius: 1.5rem;
		background:
			radial-gradient(
				120% 140% at 50% 0%,
				color-mix(in srgb, var(--accent-regular) 14%, transparent),
				transparent 60%
			),
			var(--gray-999_40);
		box-shadow: var(--shadow-md);
	}

	.eyebrow {
		font-size: var(--text-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-regular);
	}

	h2 {
		font-size: var(--text-xl);
		max-width: 22ch;
		color: var(--gray-0);
	}

	.sub {
		color: var(--gray-300);
		max-width: 42ch;
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.socials {
		display: flex;
		gap: 0.75rem;
	}

	.socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999rem;
		color: var(--gray-200);
		border: 1px solid var(--gray-800);
		background-color: var(--gray-999_40);
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition),
			transform var(--theme-transition);
	}

	.socials a:hover {
		color: var(--accent-regular);
		border-color: color-mix(in srgb, var(--accent-regular) 55%, transparent);
		transform: translateY(-2px);
	}

	@media (min-width: 50em) {
		.panel {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
			padding: 3rem 3.5rem;
			gap: 3rem;
		}

		.text {
			align-items: flex-start;
		}

		h2 {
			font-size: var(--text-2xl);
		}

		.actions {
			flex-shrink: 0;
			align-items: flex-end;
		}
	}
</style>
